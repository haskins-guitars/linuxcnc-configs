; Based on https://forum.linuxcnc.org/49-basic-configuration/50236-setting-up-a-basic-z-height-touch-off-probe-with-a-mesa-7i96

O<probe_z_puck> sub
    M73 ; Save and autorestore modal states
    G92.1 ; Cancel all G92 offsets
    ; G49 ; Cancel G43 tool length offsets
    ; G10 L20 P0 Z[#<_hal[axis.z.pos-cmd]>] ; Clear WCS Z offset
    G91 (Set incremental mode)
    
    ; Probe down using a fast feedrate
    G38.2 Z[#<_ini[ZPUCK]SEARCH_DISTANCE>] F[#<_ini[ZPUCK]SEARCH_FEED>]
    
    ; Move up to latch distance
    G0 Z[#<_ini[ZPUCK]LATCH_BACKOFF>] 
    
    ; Probe at latch speed/distance for more accurate reading
    G38.2 Z[#<_ini[ZPUCK]LATCH_DISTANCE] F[#<_ini[ZPUCK]LATCH_FEED]

    ; Set current WCS Z value = plate thickness
    G10 L20 P0 Z[#<_ini[ZPUCK]PUCK_THICKNESS]
    
    ; Raise above workpiece
    G0 Z[#<_ini[ZPUCK]FINAL_BACKOFF]        
O<probe_z_puck> endsub