; Based on https://forum.linuxcnc.org/49-basic-configuration/50236-setting-up-a-basic-z-height-touch-off-probe-with-a-mesa-7i96

O<probe_z_puck> sub
    M73 ; Save and autorestore modal states
    
    G21 ; Millimeters
    G10 L2 P0 Z0 ; Clear WCS Z offset

    G91 ; Incremental mode
    
    ; Probe down using a fast feedrate
    G38.2 Z[#<_ini[ZPUCK]SEARCH_DISTANCE>] F[#<_ini[ZPUCK]SEARCH_FEED>]
    
    ; Move up to latch distance
    G0 Z[#<_ini[ZPUCK]LATCH_BACKOFF>] 
    
    ; Probe at latch speed/distance for more accurate reading
    G38.2 Z[#<_ini[ZPUCK]LATCH_DISTANCE>] F[#<_ini[ZPUCK]LATCH_FEED>]
    
    ; Raise above workpiece
    G0 Z[#<_ini[ZPUCK]FINAL_BACKOFF>]

    #<probe_triggered_z> = #5063
    ; Combined G92 and G52 offsets(#5213) if enabled (#5210 = 1)
    #<corordinate_offset_z> = [#5213 * #5210]
    #<current_tool_offset_z> = #5403
    ; Calculated WCS Z offset
    #<wcs_z> = [#<probe_triggered_z> - #<corordinate_offset_z> - #<_ini[ZPUCK]PUCK_THICKNESS>]

    (print, probe_triggered_z=#<probe_triggered_z>)
    (print, corordinate_offset_z=#<corordinate_offset_z>)
    (print, current_tool_offset_z=#<current_tool_offset_z>)
    (print, [ZPUCK]PUCK_THICKNESS=#<_ini[ZPUCK]PUCK_THICKNESS>)
    (print, wcs_z=#<wcs_z>)
    
    G10 L2 P0 Z#<wcs_z>
O<probe_z_puck> endsub [1]
