; Load/unload tool from RapidChange pocket at the current X/Y position
o<rapidchange_hammer> sub
    ; 0 = CW = Load
    ; 1 = CCW = Unload
    #<dir> = #1
    ; Number of attempts if IR is not in expected state
    #<strikes_remaining> = #2

    ; Don't execute in UI preview
    O100 if [#<_task> EQ 0]
        (print, Skipping in preview)
    O100     return [999]
    O100 endif

    o210 while [#<strikes_remaining> gt 0]
        #<strikes_remaining> = [#<strikes_remaining> - 1]
        (print, Striking RapidChange)

        ; Move close to pocket
        G53 G0 Z[#<_ini[RAPIDCHANGEATC]ENGAGE_Z_START>]

        o213 if[#<dir> EQ 0]
            ; Spindle on
            (print, CW/Picking up)
            M3 S[#<_ini[RAPIDCHANGEATC]ENGAGE_LOAD_RPM>]
        o213 else
            ; Spindle on
            (print, CCW/Unloading)
            M4 S[#<_ini[RAPIDCHANGEATC]ENGAGE_UNLOAD_RPM>]
        o213 endif

        ; Lower into pocket
        G53 G1 Z[#<_ini[RAPIDCHANGEATC]ENGAGE_Z_END>] F[#<_ini[RAPIDCHANGEATC]ENGAGE_FEED>] 

        ; Dwell to give time to thread on/off
        G04 P0.5
        ; Stop spindle
        M5
        ; Dwell to allow spindle to stop
        G04 P0.2
        
        ; More to IR checking position
        G53 G0 Z[#<_ini[RAPIDCHANGEATC]ENGAGE_Z_START>]
    o210 endwhile

    o250 if [#<_ini[RAPIDCHANGEATC]IR_DI> lt 0]
        (print, Success. No IR DI configured, assuming success.)
    o250 return [1]
    o250 endif

    o211 if [#<_ini[RAPIDCHANGEATC]IR_DI> ge 0]
        M66 P[#<_ini[RAPIDCHANGEATC]IR_DI>] L0  ; Read IR sensor status
    
        o212 if [#<dir> eq 0 and #5399 eq 0]
            ; Loading tool
            (print, Success! Tool loaded)
        o212 return [1]
        o212 elseif [#<dir> eq 1 and #5399 eq 1]
            ; Unloading tool
            (print, Success! Tool unloaded)
        o212 return [1]
    o211 endif

    (print, Failed! Attempts exceeded.)
o<rapidchange_hammer> endsub [0]

M2
