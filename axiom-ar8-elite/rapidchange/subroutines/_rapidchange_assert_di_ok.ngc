; Assert IR_DI and TOOLSETTER_DI states are nominal
o<_rapidchange_assert_di_ok> sub
    o100 if [#<_ini[RAPIDCHANGEATC]IR_DI> lt 0]
        (print, No IR_DI configured, assuming ok.)
    o100 else
        M66 P[#<_ini[RAPIDCHANGEATC]IR_DI>] L0 ; Read DI

        o110 if [#5399 ne 0]
            (msg, Unexpected IR sensor state.)
        o110 return [-110] ; Fail
        o110 endif
    o100 endif
o<_rapidchange_assert_di_ok> endsub [1]

M2
